{
  "components": [
    {
      "label": "Headline",
      "type": "textfield",
      "layout": { "row": "Row_Title", "columns": null },
      "id": "Field_ArticleTitle",
      "key": "articleTitle",
      "disabled": true
    },
    {
      "label": "Article body",
      "type": "textarea",
      "layout": { "row": "Row_Body", "columns": null },
      "id": "Field_ArticleBody",
      "key": "articleBody",
      "disabled": true
    },
    {
      "label": "Editorial decision",
      "type": "radio",
      "layout": { "row": "Row_Decision", "columns": null },
      "id": "Field_ApprovalDecision",
      "key": "approvalDecision",
      "validate": { "required": true },
      "values": [
        { "label": "Approve for publication", "value": "APPROVE" },
        { "label": "Reject - request revision", "value": "REJECT" }
      ]
    },
    {
      "label": "Reason for revision (shown to submitter)",
      "type": "textarea",
      "layout": { "row": "Row_Reason", "columns": null },
      "id": "Field_RevisionReason",
      "key": "revisionReason"
    }
  ],
  "type": "default",
  "id": "publisher_form_approval",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": { "name": "Claude (hand-authored)", "version": "1.0" },
  "schemaVersion": 16
}
