# Camunda (cma-demo-cluster, region syd-1, Camunda 8.10, authorizations disabled)
CAMUNDA_CLUSTER_ID=11d7b228-34ce-435a-8780-37c035308e42
CAMUNDA_OAUTH_URL=
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=
CAMUNDA_ZEEBE_REST_URL=https://syd-1.api.camunda.io/11d7b228-34ce-435a-8780-37c035308e42

# Supabase (schema demo_publisher_approval - must be in Exposed schemas)
SUPABASE_URL=https://tjffiscjokrnidqbmhxs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# This app's own origin, used by the BPMN for the mock CMS and notify calls
MOCK_CMS_BASE_URL=

# Shows the "Load test article" and "Load revision test article" buttons on the form.
# Public flag (visible to the browser, not a secret). Must be off ("false" or unset) on production unless the demo is running.
NEXT_PUBLIC_SHOW_TEST_BUTTON=false

# Branding (public values, not secrets). Shown in the page header and title.
# Display name. Defaults to "Editorial Console" when empty or unset.
NEXT_PUBLIC_BRAND_NAME=Editorial Console
# Logo for the header. Recommended: /api/brand/logo, which serves a logo kept in a private Supabase Storage bucket
# (upload it once with: npm run upload:logo -- path/to/logo.png). That works locally and on Vercel and never puts the image in git.
# Also accepted: a /brand/... path to a git-ignored file in public/brand/ (local only, NOT deployed from GitHub) or an absolute https URL.
# Leave empty for a text wordmark.
NEXT_PUBLIC_BRAND_LOGO=

# Camunda Optimize dashboard for the editorial approval process. Requires a Camunda login.
# Public value (not a secret). Shown as a link on the Admin page and in the nav. Falls back to this URL when unset; an invalid value hides the link.
NEXT_PUBLIC_OPTIMIZE_DASHBOARD_URL=https://syd-1.optimize.camunda.io/11d7b228-34ce-435a-8780-37c035308e42/#/collection/216f971b-dd60-484f-9055-586f1f1c4702/dashboard/890ca2e8-6eb1-44a3-be23-7ca9ae67935e/

# Camunda AI analytics (agentic control plane): how the AI agent is used and overseen. Requires a Camunda login.
# Public value (not a secret). Falls back to this URL when unset; an invalid value hides the link.
NEXT_PUBLIC_AI_ANALYTICS_URL=https://syd-1.optimize.camunda.io/11d7b228-34ce-435a-8780-37c035308e42/#/agentic-control-plane
